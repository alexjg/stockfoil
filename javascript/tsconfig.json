{
  "compilerOptions": {
    "paths": {
      "#wasm-bodge/bindings": ["./.wasm-bodge/bindings.d.ts"],
      "#wasm-bodge/bindings/slim": ["./.wasm-bodge/bindings-slim.d.ts"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "lib": ["ES2022", "DOM", "ESNext.Disposable"]
  },
  "include": ["src/*.ts", "test/*.ts"]
}
